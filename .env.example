# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Telegram (required) ---------------------------------------------------
BOT_TOKEN=
# Comma-separated Telegram user ids. The FIRST id is the owner.
ADMIN_IDS=
# Optional per-admin roles: owner | admin | finance | support | viewer
# ADMIN_ROLES=123456789:finance,987654321:support

# --- Branding --------------------------------------------------------------
SERVICE_NAME=SMS Marketplace
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR
SUPPORT_USERNAME=
SUPPORT_RESPONSE_TIME=5-15 minutes

# --- Pricing ---------------------------------------------------------------
# Markup added on top of the provider's cost.
SERVICE_FEE_PERCENT=5
SERVICE_FEE_FIXED=0
# Clamp the final user price. 0 disables the bound.
MIN_PRICE=0
MAX_PRICE=0
# Multiply provider prices by this to reach your currency (1 = same currency).
PROVIDER_CURRENCY_RATE=1

# --- SMS provider (required) -----------------------------------------------
SMS_PROVIDER=sms_activate
SMS_ACTIVATE_API_TOKEN=
SMS_ACTIVATE_BASE_URL=https://api.sms-activate.guru/
# Seconds between polls, and how long to wait for a code before refunding.
SMS_POLL_INTERVAL=5
SMS_TIMEOUT=900
# Alert admins when the provider account drops below this (major units).
SMS_PROVIDER_LOW_BALANCE_THRESHOLD=10

# --- SMM panel (optional) --------------------------------------------------
SMM_ENABLED=false
SMM_PROVIDER=generic
SMM_API_URL=
SMM_API_KEY=
SMM_MARKUP_PERCENT=20
SMM_POLL_INTERVAL=60

# --- Payments (enable at least one) ----------------------------------------
CRYPTOBOT_ENABLED=false
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_ASSET=USDT
# How many major units one unit of CRYPTOBOT_ASSET is worth.
CRYPTOBOT_RATE=90

TELEGRAM_STARS_ENABLED=true
# How many major units one Telegram Star is worth.
TELEGRAM_STARS_RATE=2.15
TELEGRAM_STARS_MAX=2500

# --- Manual deposits (UPI / bank transfer, approved by a human) ------------
# Users send amount + UTR + screenshot; a request is posted to the review
# channel with Approve/Decline. Balance moves only on approval.
MANUAL_PAYMENT_ENABLED=false
# Channel id where requests are posted (starts with -100...).
# The bot must be an admin there, and reviewers must be in ADMIN_IDS.
MANUAL_PAYMENT_CHANNEL_ID=
# How many un-reviewed requests one user may have open at once.
MANUAL_PAYMENT_MAX_PENDING=3
# Your UPI id and bank details are the text in
# locales/en/messages.yaml under wallet.manual_details — edit them there.

PAYMENT_TIMEOUT_MINUTES=10
# How long past expiry an unreported invoice is still checked with the gateway.
# Covers a payment made while the bot was restarting.
PAYMENT_GRACE_HOURS=24
MIN_DEPOSIT=50
MAX_DEPOSIT=50000

# --- Referral programme ----------------------------------------------------
REFERRAL_ENABLED=true
REFERRAL_PERCENT=10
REFERRAL_MIN_DEPOSIT=0

# --- Features --------------------------------------------------------------
RENTAL_ENABLED=true
TRANSFER_ENABLED=false
MIN_RENTAL_HOURS=4
MAX_RENTAL_HOURS=720
# Admins keep access while maintenance mode is on.
MAINTENANCE_MODE=false

# --- Infrastructure --------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# For Postgres: postgresql+asyncpg://user:password@db:5432/bot
LOCALE=en
LOG_LEVEL=INFO
LOG_JSON=false
HTTP_TIMEOUT=20
HTTP_RETRIES=3
RATE_LIMIT_PER_SECOND=3
CACHE_TTL_SECONDS=300
