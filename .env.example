# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Telegram (required) ---------------------------------------------------
BOT_TOKEN=
# Comma-separated Telegram user ids. The FIRST id is the owner.
ADMIN_IDS=
# Optional per-admin roles: owner | admin | finance | support | viewer
# ADMIN_ROLES=123456789:finance,987654321:support

# --- Branding --------------------------------------------------------------
SERVICE_NAME=SMS Marketplace
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR
SUPPORT_USERNAME=
SUPPORT_RESPONSE_TIME=5-15 minutes

# Custom (premium) emoji, by name. Used on buttons and inside message text via
# <tg-emoji id="buy">🛍</tg-emoji> in the locale files. Telegram accepts these
# from a bot owning a Fragment username, or from any bot whose owner has
# Telegram Premium, in private/group/supergroup chats. Everything renders fine
# without them, falling back to the plain character.
# CUSTOM_EMOJI=buy:5350513667437440642,wallet:5352640560718949874

# --- Pricing ---------------------------------------------------------------
# Markup added on top of the provider's cost.
SERVICE_FEE_PERCENT=5
SERVICE_FEE_FIXED=0
# Clamp the final user price. 0 disables the bound.
MIN_PRICE=0
MAX_PRICE=0
# Multiply provider prices by this to reach your currency (1 = same currency).
PROVIDER_CURRENCY_RATE=1

# --- SMS provider (required) -----------------------------------------------
# sms_activate = SMS-Activate and faithful clones.
# temporasms   = api.temporasms.com (needs an operator, prices come per country).
SMS_PROVIDER=sms_activate
SMS_ACTIVATE_API_TOKEN=
SMS_ACTIVATE_BASE_URL=https://api.sms-activate.guru/
# Seconds between polls, and how long to wait for a code before refunding.
SMS_POLL_INTERVAL=5
SMS_TIMEOUT=900
# Alert admins when the provider account drops below this (major units).
SMS_PROVIDER_LOW_BALANCE_THRESHOLD=10

# --- SMM panel (optional) --------------------------------------------------
SMM_ENABLED=false
SMM_PROVIDER=generic
SMM_API_URL=
SMM_API_KEY=
SMM_MARKUP_PERCENT=20
SMM_POLL_INTERVAL=60

# --- Payments (enable at least one) ----------------------------------------
# --- Other deposit methods (off by default) --------------------------------
# Both are implemented and tested; turn one on if you want it.

# Crypto via @CryptoBot. Note CRYPTOBOT_RATE is fixed, not a live market rate,
# so it needs updating as the asset moves.
CRYPTOBOT_ENABLED=false
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_ASSET=USDT
# How many major units one unit of CRYPTOBOT_ASSET is worth.
CRYPTOBOT_RATE=90

# Telegram Stars. Needs no API key; Telegram handles the checkout.
TELEGRAM_STARS_ENABLED=false
# How many major units one Telegram Star is worth.
TELEGRAM_STARS_RATE=2.15
TELEGRAM_STARS_MAX=2500

# --- UPI deposits (the primary method) -------------------------------------
# The user pays by UPI, then sends the UTR and a screenshot. A request is
# posted to your review channel with Approve / Decline, and the balance moves
# only on approval.
MANUAL_PAYMENT_ENABLED=true

# Your UPI id. Always shown as copyable text next to the QR.
UPI_ID=
# Name the payer sees in their app. Defaults to SERVICE_NAME.
UPI_PAYEE_NAME=

# Your own QR image — one code shown for every deposit. Put it in assets/,
# which is mounted into the container so swapping it needs no rebuild.
# Leave empty to have the bot generate a code per request with the amount
# already inside it, which stops payers sending the wrong sum.
UPI_QR_IMAGE=

# Channel where deposit requests are posted (id starts with -100...).
# The bot must be an admin there. Reviewers need the `balance` permission:
# owner, admin or finance.
MANUAL_PAYMENT_CHANNEL_ID=
# How many un-reviewed requests one user may have open at once.
MANUAL_PAYMENT_MAX_PENDING=3

PAYMENT_TIMEOUT_MINUTES=10
# How long past expiry an unreported invoice is still checked with the gateway.
# Covers a payment made while the bot was restarting.
PAYMENT_GRACE_HOURS=24
MIN_DEPOSIT=100
MAX_DEPOSIT=50000

# --- Referral programme ----------------------------------------------------
REFERRAL_ENABLED=true
REFERRAL_PERCENT=10
REFERRAL_MIN_DEPOSIT=0

# --- Features --------------------------------------------------------------
TRANSFER_ENABLED=false
# Admins keep access while maintenance mode is on.
MAINTENANCE_MODE=false

# --- Backups ---------------------------------------------------------------
# The database holds every user's balance. Losing it means being unable to
# honour a single deposit, so leave this on.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
# Where scheduled backups are sent. Empty means the owner's DM; a private
# channel is better, since it survives losing the phone.
BACKUP_CHAT_ID=

# --- Infrastructure --------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# For Postgres: postgresql+asyncpg://user:password@db:5432/bot
LOCALE=en
LOG_LEVEL=INFO
LOG_JSON=false
HTTP_TIMEOUT=20
HTTP_RETRIES=3
# How long a shutdown waits for in-flight handlers before cancelling them.
SHUTDOWN_DRAIN_SECONDS=15
RATE_LIMIT_PER_SECOND=3
CACHE_TTL_SECONDS=300
